# ==============================================================================
# SERVORA ISOLATED STAGING LOAD TEST CONFIGURATION (TEMPLATE ONLY)
# Copy this file to: tests/load/.env.staging
# NEVER copy client/.env or server/.env here.
# NEVER put production project ref (oliuhzkbnxjiwkrdlcfv) here.
# ==============================================================================

# Must be a SEPARATE Supabase project dedicated strictly to staging/load testing
STAGING_SUPABASE_PROJECT_REF=your-staging-project-ref
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Public app origin used ONLY for synthetic QR URL generation & signature checks
STAGING_PUBLIC_ORIGIN=https://staging-menu.servora.invalid

# Optional overrides for load profiles
LOADTEST_RESTAURANT_COUNT=100
LOADTEST_MAX_RPS=250
LOADTEST_ABORT_ERROR_RATE=0.15
