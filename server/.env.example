# Servora Backend API Environment Template
# Copy to server/.env and fill with real private credentials (NEVER commit server/.env)

PORT=5000
NODE_ENV=development

# Authoritative Supabase Admin Access (Server-Only — NEVER expose to client/)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# CORS & Phishing-Safe Redirect Origin Allowlist
FRONTEND_URL=https://servora.quantumesh.in
ALLOWED_ORIGINS=https://servora.quantumesh.in,https://www.servora.quantumesh.in

# Gmail SMTP Credentials (App Password Only)
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM="Servora Platform <your-sender@gmail.com>"
