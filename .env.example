# ========================================================
# SERVORA CLOUDFLARE PAGES ENVIRONMENT CONFIGURATION (.env)
# Use placeholders only in tracked templates. Set real values in host secrets.
# ========================================================

# Supabase Cloud Database & Authentication (Public Browser Keys)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Cloudinary Storage for Dish Photos & Logos (Unsigned Upload Preset)
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-cloudinary-unsigned-preset

# Canonical Production App URL
VITE_APP_URL=https://servora.quantumesh.in

# Optional Authoritative Backend API URL
# VITE_API_URL=https://api.servora.quantumesh.in

# Optional Platform UPI VPA for subscription checkout
# VITE_PLATFORM_UPI_ID=your-merchant@bank
